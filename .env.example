# ===========================================
# Environment Configuration
# Copy this file to .env and fill in your values
# ===========================================

# Application URL (public base URL of the app)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Canonical website origin. Set to the final public domain before deployment.
# Falls back to NEXT_PUBLIC_BETTER_AUTH_URL for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication Secret (min 32 characters)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long

# Database Connection (PostgreSQL)
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://user:password@localhost:5432/dashboard

# ===========================================
# Optional Configuration
# ===========================================

# Email Service (Resend) — used for password reset emails.
# When unset, reset links are logged to the server console instead.
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Email sender address (must be a verified domain in Resend)
# BETTER_AUTH_EMAIL=noreply@yourdomain.com

# Public website enquiry sender (must belong to a verified Resend domain).
# Set this together with RESEND_API_KEY to enable direct enquiry submission.
# Enquiries go to the fixed company address in the catalogue configuration.
# Until configured, the website offers an email draft instead of claiming delivery.
# CONTACT_FROM_EMAIL=website@yourdomain.com

# Skip environment validation (not recommended for production)
# SKIP_ENV_VALIDATION=true
